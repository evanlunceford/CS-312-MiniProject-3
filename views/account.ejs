<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head") %>
</head>
<body>
  <%- include("partials/nav") %>

  <main class="container container-narrow">
    <section class="section">
      <h2 class="section-title">Account</h2>
      <%- include("partials/alert", { type: "notice", message: notice }) %>
      <%- include("partials/alert", { type: "error", message: error }) %>

      <form class="form" action="/account" method="POST">
        <div class="form-field">
          <label for="user_id">User ID</label>
          <input type="text" id="user_id" name="user_id" value="<%= values.user_id %>"
            minlength="3" maxlength="50" pattern="[A-Za-z0-9_.\-]+" autocomplete="username" required />
        </div>
        <div class="form-field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" value="<%= values.name %>" maxlength="100" required />
        </div>

        <fieldset class="form-group">
          <legend>Change password</legend>
          <span class="form-hint">Leave blank to keep your current password.</span>
          <div class="form-field">
            <label for="new_password">New password</label>
            <input type="password" id="new_password" name="new_password" minlength="6" maxlength="72" autocomplete="new-password" />
          </div>
          <div class="form-field">
            <label for="confirm_password">Confirm new password</label>
            <input type="password" id="confirm_password" name="confirm_password" minlength="6" maxlength="72" autocomplete="new-password" />
          </div>
        </fieldset>

        <div class="form-field">
          <label for="current_password">Current password</label>
          <input type="password" id="current_password" name="current_password" autocomplete="current-password" required />
          <span class="form-hint">Required to save any changes.</span>
        </div>

        <div class="form-actions">
          <button type="submit" class="button">Save changes</button>
        </div>
      </form>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
