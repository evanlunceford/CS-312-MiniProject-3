<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head") %>
</head>
<body>
  <%- include("partials/nav") %>

  <main class="container">
    <section class="section">
      <h2 class="section-title">New post</h2>
      <%- include("partials/alert", { type: "error", message: error }) %>
      <%- include("partials/postForm", { values: values, categories: categories, formAction: "/posts", submitLabel: "Publish" }) %>
    </section>

    <section class="section">
      <h2 class="section-title">Posts</h2>
      <%- include("partials/categoryFilter", { categories: categories, activeCategory: activeCategory }) %>

      <% if (posts.length === 0) { %>
        <p class="empty-state">No posts here yet.</p>
      <% } %>
      <% posts.forEach(function(post) { %>
        <%- include("partials/postCard", { post: post, isOwner: post.creator_user_id === currentUser.id }) %>
      <% }); %>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
