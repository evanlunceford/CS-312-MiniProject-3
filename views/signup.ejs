<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head") %>
</head>
<body>
  <%- include("partials/nav") %>

  <main class="container container-narrow">
    <section class="section">
      <h2 class="section-title">Create an account</h2>
      <%- include("partials/alert", { type: "error", message: error }) %>

      <form class="form" action="/signup" method="POST">
        <div class="form-field">
          <label for="user_id">User ID</label>
          <input type="text" id="user_id" name="user_id" value="<%= values.user_id || '' %>"
            minlength="3" maxlength="50" pattern="[A-Za-z0-9_.\-]+" autocomplete="username" required autofocus />
          <span class="form-hint">3–50 characters: letters, numbers, dots, dashes, underscores.</span>
        </div>
        <div class="form-field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" value="<%= values.name || '' %>" maxlength="100" autocomplete="name" required />
          <span class="form-hint">Shown on your posts.</span>
        </div>
        <div class="form-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" minlength="6" maxlength="72" autocomplete="new-password" required />
        </div>
        <div class="form-field">
          <label for="confirm_password">Confirm password</label>
          <input type="password" id="confirm_password" name="confirm_password" minlength="6" maxlength="72" autocomplete="new-password" required />
        </div>
        <div class="form-actions">
          <button type="submit" class="button">Sign up</button>
        </div>
      </form>

      <p class="form-footnote">Already have an account? <a href="/signin">Sign in</a></p>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
